{
  "name": "Challenge",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly"
      ],
      "default": "daily"
    },
    "target": {
      "type": "number",
      "default": 5
    },
    "metric": {
      "type": "string",
      "enum": [
        "items_recycled",
        "plastic_saved",
        "co2_reduced",
        "streak_days"
      ],
      "default": "items_recycled"
    },
    "xp_reward": {
      "type": "number",
      "default": 50
    },
    "eco_points_reward": {
      "type": "number",
      "default": 20
    },
    "badge": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title"
  ]
}