{
  "name": "RecycleLog",
  "type": "object",
  "properties": {
    "material": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "weight_kg": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "centre_id": {
      "type": "string"
    },
    "centre_name": {
      "type": "string"
    },
    "eco_points_earned": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "qr_checkin"
      ],
      "default": "manual"
    }
  },
  "required": [
    "material"
  ]
}