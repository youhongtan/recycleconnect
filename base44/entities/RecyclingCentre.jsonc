{
  "name": "RecyclingCentre",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "hours": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Plastic",
          "Paper",
          "Glass",
          "Metal",
          "Electronics",
          "Batteries",
          "Clothes",
          "Cooking Oil"
        ]
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "Mall Drop-off",
        "Council Centre",
        "Scrap Dealer",
        "Community Point",
        "E-Waste Collector",
        "Oil Collector",
        "Fabric Bank"
      ],
      "default": "Community Point"
    },
    "pays_cash": {
      "type": "boolean",
      "default": false
    },
    "reward_points": {
      "type": "boolean",
      "default": false
    },
    "home_collection": {
      "type": "boolean",
      "default": false
    },
    "qr_code_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "address"
  ]
}