{
  "name": "Reward",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "eco_points_cost": {
      "type": "number",
      "default": 100
    },
    "image_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Eco Product",
        "Discount",
        "Voucher",
        "School Reward"
      ],
      "default": "Eco Product"
    },
    "available": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "eco_points_cost"
  ]
}